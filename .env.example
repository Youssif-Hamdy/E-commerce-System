# ============================================================
# SERVER CONFIG
# ============================================================
NODE_ENV=development
PORT=3000
APP_NAME=Sales-Inventory-ZATCA

# ============================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://postgres.mbyhqjawgvktohodatvw:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.mbyhqjawgvktohodatvw:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ============================================================
# JWT
# Access Token  = 30 days
# Refresh Token = 7 days
# ============================================================
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# ZATCA CONFIGURATION
# ENV: mock | sandbox | production
# ============================================================
ZATCA_ENV=mock

# --- Seller Info (أضف بيانات العميل لما تتوفر) ---
ZATCA_SELLER_NAME="My Company Name"
ZATCA_VAT_NUMBER="300000000000003"
ZATCA_CR_NUMBER="1234567890"
ZATCA_BUILDING_NUMBER="1234"
ZATCA_STREET="King Fahad Road"
ZATCA_DISTRICT="Al Olaya"
ZATCA_CITY="Riyadh"
ZATCA_COUNTRY_CODE="SA"
ZATCA_POSTAL_CODE="12345"

# --- ZATCA API (Production - لما العميل يجيب credentials) ---
ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_SANDBOX_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_COMPLIANCE_REQUEST_ID=
ZATCA_OTP=
ZATCA_CSID=
ZATCA_PRIVATE_KEY=
ZATCA_CERTIFICATE=

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
