generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  email                String         @unique
  password             String
  phone                String?
  roleId               String
  isActive             Boolean        @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  googleId             String?        @unique
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  auditLogs            AuditLog[]
  purchases            Purchase[]
  refreshTokens        RefreshToken[]
  sales                Sale[]
  stockCounts          StockCount[]
  role                 Role           @relation(fields: [roleId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Unit {
  id        String    @id @default(uuid())
  name      String    @unique
  symbol    String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("units")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id                    String                 @id @default(uuid())
  sku                   String                 @unique
  name                  String
  nameAr                String?
  description           String?
  categoryId            String
  unitId                String
  purchasePrice         Decimal                @default(0) @db.Decimal(15, 2)
  salePrice             Decimal                @default(0) @db.Decimal(15, 2)
  vatRate               Decimal                @default(15) @db.Decimal(5, 2)
  isVatExempt           Boolean                @default(false)
  barcode               String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  category              Category               @relation(fields: [categoryId], references: [id])
  unit                  Unit                   @relation(fields: [unitId], references: [id])
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  stockCountItems       StockCountItem[]

  @@map("products")
}

model Warehouse {
  id        String      @id @default(uuid())
  name      String      @unique
  location  String?
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  inventory Inventory[]

  @@map("warehouses")
}

model Inventory {
  id              String    @id @default(uuid())
  productId       String
  warehouseId     String
  currentQuantity Decimal   @default(0) @db.Decimal(15, 3)
  minimumQuantity Decimal   @default(0) @db.Decimal(15, 3)
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("inventory")
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  productId   String
  warehouseId String?
  type        TransactionType
  quantity    Decimal         @db.Decimal(15, 3)
  reference   String?
  notes       String?
  createdAt   DateTime        @default(now())
  product     Product         @relation(fields: [productId], references: [id])

  @@map("inventory_transactions")
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  vatNumber String?
  crNumber  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String     @default("SA")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(uuid())
  purchaseNumber String         @unique
  supplierId     String
  userId         String
  status         PurchaseStatus @default(PENDING)
  subtotal       Decimal        @db.Decimal(15, 2)
  vatAmount      Decimal        @db.Decimal(15, 2)
  total          Decimal        @db.Decimal(15, 2)
  notes          String?
  purchaseDate   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  purchaseItems  PurchaseItem[]
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(15, 3)
  unitCost   Decimal  @db.Decimal(15, 2)
  vatRate    Decimal  @db.Decimal(5, 2)
  vatAmount  Decimal  @db.Decimal(15, 2)
  total      Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  vatNumber String?
  crNumber  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String   @default("SA")
  isWalkIn  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  returns   Return[]
  sales     Sale[]

  @@map("customers")
}

model Sale {
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  customerId     String?
  userId         String
  status         SaleStatus    @default(PENDING)
  subtotal       Decimal       @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @db.Decimal(15, 2)
  vatAmount      Decimal       @db.Decimal(15, 2)
  total          Decimal       @db.Decimal(15, 2)
  paymentMethod  PaymentMethod @default(CASH)
  notes          String?
  saleDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoice        Invoice?
  payments       Payment[]
  returns        Return[]
  saleItems      SaleItem[]
  customer       Customer?     @relation(fields: [customerId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal  @db.Decimal(15, 3)
  unitPrice Decimal  @db.Decimal(15, 2)
  discount  Decimal  @default(0) @db.Decimal(15, 2)
  vatRate   Decimal  @db.Decimal(5, 2)
  vatAmount Decimal  @db.Decimal(15, 2)
  total     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String
  amount    Decimal       @db.Decimal(15, 2)
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id])

  @@map("payments")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  uuid            String        @unique @default(uuid())
  saleId          String        @unique
  type            InvoiceType   @default(SIMPLIFIED)
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  subtotal        Decimal       @db.Decimal(15, 2)
  vatAmount       Decimal       @db.Decimal(15, 2)
  total           Decimal       @db.Decimal(15, 2)
  xmlContent      String?
  xmlHash         String?
  signedXml       String?
  qrCode          String?
  zatcaStatus     String?
  zatcaResponse   Json?
  zatcaRetryCount Int           @default(0)
  errorMessage    String?
  submittedAt     DateTime?
  clearedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoiceItems    InvoiceItem[]
  sale            Sale          @relation(fields: [saleId], references: [id])
  zatcaLogs       ZatcaLog[]

  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  productId String?
  name      String
  nameAr    String?
  quantity  Decimal  @db.Decimal(15, 3)
  unitPrice Decimal  @db.Decimal(15, 2)
  discount  Decimal  @default(0) @db.Decimal(15, 2)
  vatRate   Decimal  @db.Decimal(5, 2)
  vatAmount Decimal  @db.Decimal(15, 2)
  total     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Return {
  id           String       @id @default(uuid())
  returnNumber String       @unique
  saleId       String
  customerId   String?
  status       ReturnStatus @default(PENDING)
  reason       String?
  subtotal     Decimal      @db.Decimal(15, 2)
  vatAmount    Decimal      @db.Decimal(15, 2)
  total        Decimal      @db.Decimal(15, 2)
  returnDate   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  creditNote   CreditNote?
  returnItems  ReturnItem[]
  customer     Customer?    @relation(fields: [customerId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])

  @@map("returns")
}

model ReturnItem {
  id        String   @id @default(uuid())
  returnId  String
  productId String
  quantity  Decimal  @db.Decimal(15, 3)
  unitPrice Decimal  @db.Decimal(15, 2)
  vatRate   Decimal  @db.Decimal(5, 2)
  vatAmount Decimal  @db.Decimal(15, 2)
  total     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  return    Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_items")
}

model CreditNote {
  id            String        @id @default(uuid())
  noteNumber    String        @unique
  uuid          String        @unique @default(uuid())
  returnId      String        @unique
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(15, 2)
  vatAmount     Decimal       @db.Decimal(15, 2)
  total         Decimal       @db.Decimal(15, 2)
  xmlContent    String?
  signedXml     String?
  qrCode        String?
  zatcaStatus   String?
  zatcaResponse Json?
  issueDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  return        Return        @relation(fields: [returnId], references: [id])

  @@map("credit_notes")
}

model StockCount {
  id              String           @id @default(uuid())
  reference       String           @unique
  warehouseId     String?
  status          StockCountStatus @default(DRAFT)
  notes           String?
  startedAt       DateTime?
  completedAt     DateTime?
  approvedAt      DateTime?
  userId          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stockCountItems StockCountItem[]
  user            User             @relation(fields: [userId], references: [id])

  @@map("stock_counts")
}

model StockCountItem {
  id             String     @id @default(uuid())
  stockCountId   String
  productId      String
  systemQuantity Decimal    @db.Decimal(15, 3)
  actualQuantity Decimal?   @db.Decimal(15, 3)
  difference     Decimal?   @db.Decimal(15, 3)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  product        Product    @relation(fields: [productId], references: [id])
  stockCount     StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@map("stock_count_items")
}

model ZatcaSettings {
  id                  String   @id @default(uuid())
  sellerName          String
  sellerNameAr        String?
  vatNumber           String
  crNumber            String?
  buildingNumber      String?
  street              String?
  district            String?
  city                String?
  countryCode         String   @default("SA")
  postalCode          String?
  environment         String   @default("mock")
  complianceRequestId String?
  csid                String?
  privateKey          String?
  certificate         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("zatca_settings")
}

model ZatcaLog {
  id              String   @id @default(uuid())
  invoiceId       String?
  action          String
  requestPayload  Json?
  responsePayload Json?
  status          String
  httpStatus      Int?
  errorMessage    String?
  createdAt       DateTime @default(now())
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("zatca_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ZatcaUnit {
  id          String           @id @default(uuid())
  name        String
  environment String
  status      ZatcaUnitStatus  @default(NOT_CONNECTED)
  lastIcv     Int              @default(0)
  lastHash    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  credentials ZatcaCredential?

  @@map("zatca_units")
}

model ZatcaCredential {
  id                  String    @id @default(uuid())
  unitId              String    @unique
  privateKey          String
  csr                 String
  complianceCsid      String?
  complianceSecret    String?
  complianceRequestId String?
  productionCsid      String?
  productionSecret    String?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  unit                ZatcaUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("zatca_credentials")
}

enum TransactionType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  STOCK_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_STOCK
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum InvoiceType {
  STANDARD
  SIMPLIFIED
  CREDIT_NOTE
  DEBIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  READY
  SUBMITTED
  REPORTED
  CLEARED
  COMPLETED
  FAILED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

enum ZatcaUnitStatus {
  NOT_CONNECTED
  COMPLIANCE
  CONNECTED
  EXPIRED
  FAILED
}
